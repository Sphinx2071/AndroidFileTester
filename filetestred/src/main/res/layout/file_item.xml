<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_file_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="12dp"
    android:paddingHorizontal="8dp">

    <ImageView
        android:id="@+id/iv_file_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_file_text_line"
        android:contentDescription="file_icon"
        android:layout_marginEnd="12dp" />

    <ImageView
        android:id="@+id/iv_folder_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_folder_line"
        android:contentDescription="file_icon"
        android:layout_marginEnd="12dp"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/tv_file_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="FileName.txt"
        android:textAppearance="?attr/textAppearanceBody1" />

    <ImageButton
        android:id="@+id/btn_file_overflow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_more_2_fill"
        android:contentDescription="more_options"
        android:background="?attr/selectableItemBackgroundBorderless"/>
</LinearLayout>
